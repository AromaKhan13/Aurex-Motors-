          priceLabel.textContent = '$650,000+ USD';
        } else {
          priceLabel.textContent = '$' + val.toLocaleString('en-US') + ' USD';
        }
      });
    }

    // Marque and Spec Chip Toggle Logic
    const allChips = document.querySelectorAll('.filter-chip, .year-chip, .trans-chip');
    allChips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        const isSelected = chip.classList.contains('bg-primary/15');
        if (isSelected) {
          chip.classList.remove('bg-primary/15', 'text-primary');
          chip.classList.add('bg-surface-container', 'text-on-surface-variant');
        } else {
          chip.classList.remove('bg-surface-container', 'text-on-surface-variant');
          chip.classList.add('bg-primary/15', 'text-primary');
        }
      });
    });

    // Clear All Filters Function
    if (clearFilterBtn) {
      clearFilterBtn.addEventListener('click', function () {
        if (priceSlider && priceLabel) {
          priceSlider.value = 650000;
          priceLabel.textContent = '$650,000+ USD';
        }
        allChips.forEach(function (chip) {
          chip.classList.remove('bg-primary/15', 'text-primary');
          chip.classList.add('bg-surface-container', 'text-on-surface-variant');
        });
      });
    }

    // Condition Segmented Tab Behavior
    const conditionTabs = document.querySelectorAll('.condition-tab');
    conditionTabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        conditionTabs.forEach(function (t) {
          t.classList.remove('bg-primary', 'text-on-primary', 'font-semibold', 'active');
          t.classList.add('bg-surface-container', 'text-on-surface-variant', 'font-medium');
        });
