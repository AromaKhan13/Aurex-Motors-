<script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('aurexFinanceCalculator', () => ({
        vehiclePrice: 374900,
        downPaymentPercent: 20,
        downPayment: Math.round(374900 * 0.20),
        durationMonths: 48,
        annualRate: 6.5,
        financeType: 'loan', // 'loan' or 'lease'

        setDownPaymentPercent(pct) {
          this.downPaymentPercent = pct;
          this.updateDownPaymentFromPercent();
        },

        updateDownPaymentPercent() {
          if (this.vehiclePrice > 0) {
            this.downPaymentPercent = Math.min(100, Math.round((this.downPayment / this.vehiclePrice) * 100));
          }
        },

        updateDownPaymentFromPercent() {
          this.downPayment = Math.round((this.vehiclePrice * this.downPaymentPercent) / 100);
        },

        resetDefaults() {
          this.vehiclePrice = 374900;
          this.downPaymentPercent = 20;
          this.updateDownPaymentFromPercent();
          this.durationMonths = 48;
          this.annualRate = 6.5;
          this.financeType = 'loan';
        },

        recalculate() {
          // Reactive refresh
        },

        get principalFinanced() {
          return Math.max(0, this.vehiclePrice - this.downPayment);
        },

        get monthlyPayment() {
          const P = this.principalFinanced;
          const n = this.durationMonths;
          if (P <= 0 || n <= 0) return 0;

          if (this.financeType === 'loan') {
            // Standard Amortization Formula: M = P * [ r(1 + r)^n ] / [ (1 + r)^n - 1 ]
            const r = (this.annualRate / 100) / 12;
            if (r === 0) return Math.round(P / n);
            const monthly = P * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
            return Math.round(monthly);
          } else {
            // Simplified Private Lease Estimation
            const residualPercentage = n <= 24 ? 0.62 : (n <= 36 ? 0.54 : (n <= 48 ? 0.48 : 0.42));
            const residualValue = this.vehiclePrice * residualPercentage;
            const netDepreciation = Math.max(0, (this.vehiclePrice - this.downPayment) - residualValue);
            const baseDepreciationPerMonth = netDepreciation / n;
            const moneyFactor = (this.annualRate / 100) / 24;
            const financeFeePerMonth = (this.vehiclePrice + residualValue) * moneyFactor;
            return Math.round(baseDepreciationPerMonth + financeFeePerMonth);
          }
        },

        get totalPayment() {
          return (this.monthlyPayment * this.durationMonths) + this.downPayment;
        },

        get totalInterest() {
          return Math.max(0, this.totalPayment - this.vehiclePrice);
        },

        formatCurrency(val) {
          return new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'USD',
            maximumFractionDigits: 0
          }).format(val || 0);
        }
      }));
    });
  </script>
