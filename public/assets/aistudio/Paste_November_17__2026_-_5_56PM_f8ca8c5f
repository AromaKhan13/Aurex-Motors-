        tab.classList.remove('bg-surface-container', 'text-on-surface-variant', 'font-medium');
      });
    });

    // Bookmark / Favorite Interactive Feedback
    const favoriteButtons = document.querySelectorAll('.favorite-toggle');
    favoriteButtons.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        const icon = btn.querySelector('.material-symbols-outlined');
        if (!icon) return;
        const isFilled = icon.style.fontVariationSettings && icon.style.fontVariationSettings.includes("'FILL' 1");
        if (isFilled) {
          icon.style.fontVariationSettings = "'FILL' 0";
          btn.classList.remove('text-primary');
          btn.classList.add('text-on-surface-variant');
        } else {
          icon.style.fontVariationSettings = "'FILL' 1";
          btn.classList.add('text-primary');
          btn.classList.remove('text-on-surface-variant');
        }
      });
    });

    // Load More feedback
    const loadMoreBtn = document.getElementById('load-more-btn');
    if (loadMoreBtn) {
